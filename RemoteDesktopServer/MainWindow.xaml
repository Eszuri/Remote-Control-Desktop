<Window x:Class="RemoteDesktopServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Remote Control Server"
        Height="730"
        Width="1080"
        MinWidth="780"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushCanvas}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontUi}"
        Icon="Assets/app.png"
        RenderOptions.BitmapScalingMode="HighQuality"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        SizeChanged="MainWindow_SizeChanged"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0"
                Style="{StaticResource PanelCardStyle}"
                Padding="18,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Engine Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource BrushSurfaceRaised}" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1" Margin="0,0,12,0" Padding="5">
                            <Image Source="Assets/app_emblem.png" Width="24" Height="24" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PC Remote Control Server"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <Border Background="{StaticResource BrushSurfaceInset}"
                                        BorderBrush="{StaticResource BrushBorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCaptureEngine"
                                               Text="⚡ DirectX DXGI (GPU)"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccent}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Low-latency desktop streaming &amp; full input control for Android"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Status & Action Controls -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border x:Name="StatusBadge"
                            Style="{StaticResource StatusBadgeStyle}"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="Server status">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusIndicatorDot"
                                     Width="8"
                                     Height="8"
                                     Fill="{StaticResource BrushSuccess}"
                                     Margin="0,0,8,0" />
                            <TextBlock x:Name="TxtStatus"
                                       Text="STOPPED"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushSuccess}" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnToggleServer"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Start Server"
                            Width="136"
                            Click="BtnToggleServer_Click"
                            AutomationProperties.Name="Start or stop server"
                            ToolTip="Start or stop the WebSocket server"
                            TabIndex="3" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (2-Column Grid) -->
        <Grid x:Name="MainContentGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="340" MaxWidth="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Connection & Settings -->
            <Border x:Name="ConnectionPanel"
                    Grid.Column="0"
                    Style="{StaticResource PanelCardStyle}"
                    Padding="16"
                    Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <!-- Quick Pairing Card -->
                        <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Pair Mobile Device" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10" />

                                <!-- QR Code Box -->
                                <Border x:Name="BorderQrThumbnail"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        HorizontalAlignment="Center"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="BorderQrThumbnail_MouseLeftButtonDown"
                                        ToolTip="Click to view enlarged QR code"
                                        Margin="0,0,0,12">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image x:Name="ImgQrCode"
                                               Width="140"
                                               Height="140"
                                               Stretch="Uniform"
                                               AutomationProperties.Name="Server connection QR code" />
                                        <TextBlock Text="🔍 Click to enlarge"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#475569"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- IP Address with Copy Button -->
                                <TextBlock Text="Server IP Address" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtIpAddress"
                                             IsReadOnly="True"
                                             FontWeight="Bold"
                                             Foreground="{StaticResource BrushAccent}"
                                             FontSize="13"
                                             TabIndex="1" />
                                    <Button x:Name="BtnCopyIp"
                                            Grid.Column="1"
                                            Content="Copy"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="6,0,0,0"
                                            Click="BtnCopyIp_Click"
                                            ToolTip="Copy server IP address"
                                            TabIndex="2" />
                                </Grid>
                                <TextBlock x:Name="TxtCopyFeedback"
                                           Text=""
                                           FontSize="10"
                                           Foreground="{StaticResource BrushSuccess}"
                                           HorizontalAlignment="Right"
                                           Margin="0,-8,0,8" />

                                <!-- Port and Active Clients Side by Side -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Port Input -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Port (TCP)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPort"
                                                 Text="9090"
                                                 LostFocus="TxtPort_LostFocus"
                                                 TextChanged="TxtPort_TextChanged"
                                                 ToolTip="TCP Port for WebSocket connection"
                                                 TabIndex="0" />
                                        <TextBlock x:Name="TxtPortValidation"
                                                   Text=""
                                                   Style="{StaticResource ValidationTextStyle}" />
                                    </StackPanel>

                                    <!-- Active Clients Badge -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Active Clients" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                                        <Border Background="{StaticResource BrushSurfaceInset}"
                                                BorderBrush="{StaticResource BrushBorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Height="36"
                                                Padding="8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" />
                                                <TextBlock x:Name="TxtClientCount"
                                                           Text="0 Devices"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource BrushSuccess}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Stream Performance Card -->
                        <Border Style="{StaticResource InnerCardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Stream Performance" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />

                                <!-- FPS Slider -->
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Target FPS" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock x:Name="TxtFpsVal"
                                               Text="30 FPS"
                                               Style="{StaticResource ValueTextStyle}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderFps"
                                        Minimum="10"
                                        Maximum="60"
                                        Value="30"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="SliderFps_ValueChanged"
                                        ToolTip="Target frame rate (10 to 60 FPS)"
                                        TabIndex="4" />

                                <!-- Quality Slider -->
                                <DockPanel Margin="0,10,0,2">
                                    <TextBlock Text="JPEG Quality" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock x:Name="TxtQualityVal"
                                               Text="70%"
                                               Style="{StaticResource ValueTextStyle}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SliderQuality"
                                        Minimum="20"
                                        Maximum="95"
                                        Value="70"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="SliderQuality_ValueChanged"
                                        ToolTip="JPEG Compression Quality (20% to 95%)"
                                        TabIndex="5" />
                            </StackPanel>
                        </Border>

                        <!-- System Preferences Card -->
                        <Border Style="{StaticResource InnerCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Launch on Startup"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Run server in tray on Windows boot"
                                               FontSize="10"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkLaunchStartup"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Click="ChkLaunchStartup_Click"
                                          ToolTip="Start server automatically on Windows startup"
                                          TabIndex="6" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Live Activity Console -->
            <Border x:Name="ActivityPanel"
                    Grid.Column="1"
                    Style="{StaticResource PanelCardStyle}"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Console Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Live Activity Console" Style="{StaticResource SectionTitleStyle}" />
                                <Border Background="{StaticResource BrushSurfaceRaised}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6,1"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="Real-Time Log" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Server telemetry, connection events, and frame metrics"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="BtnClearLogs"
                                Content="Clear Log"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="BtnClearLogs_Click"
                                ToolTip="Clear activity log"
                                TabIndex="7" />
                    </DockPanel>

                    <!-- Terminal Console Box -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BrushSurfaceInset}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <TextBox x:Name="TxtLogs"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="12"
                                 Background="Transparent"
                                 Foreground="{StaticResource BrushAccent}"
                                 BorderThickness="0"
                                 Padding="0"
                                 AutomationProperties.Name="Server activity log" />
                    </Border>

                    <!-- Bottom Info Banner -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BrushSurfaceRaised}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Connection Guide"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushWarning}" />
                                <TextBlock Text="Scan the QR code with your mobile app to pair instantly. When closed (X), the server continues running seamlessly in the system tray."
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterStatus"
                           Text="Server stopped"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0" />
                <TextBlock Grid.Column="1"
                           Text="PC Remote Control Server v1.2.0"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="11"
                           TextAlignment="Right" />
            </Grid>
        </Border>

        <!-- Modal Overlay for Enlarged Centered QR Code -->
        <Grid x:Name="QrModalOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#E00B111E"
              MouseDown="QrModalOverlay_MouseDown">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="24"
                    MaxWidth="450"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseDown="QrModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.7" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Modal Header -->
                    <DockPanel Margin="0,0,0,16" Width="360">
                        <StackPanel>
                            <TextBlock Text="📱 Scan QR Code to Connect" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Point your mobile camera to instantly pair" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="✕"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Padding="8,4"
                                FontSize="13"
                                FontWeight="Bold"
                                Click="BtnCloseQrModal_Click"/>
                    </DockPanel>

                    <!-- Enlarged QR Code -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <Image x:Name="ImgQrCodeEnlarged"
                               Width="300"
                               Height="300"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Connection Info Badges -->
                    <Border Background="{StaticResource BrushSurfaceRaised}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14,10"
                            Width="360"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Server Address" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock x:Name="TxtModalIpAddress" Text="192.168.0.103:9090" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                            </StackPanel>
                            <TextBlock Text="Instant Connect" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Content="Close (or press Esc)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="24,8"
                            Click="BtnCloseQrModal_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
