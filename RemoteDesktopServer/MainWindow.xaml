<Window x:Class="RemoteDesktopServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Remote Control Server"
        Height="720"
        Width="1040"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushCanvas}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontUi}"
        SizeChanged="MainWindow_SizeChanged"
        KeyDown="Window_KeyDown">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource PanelCardStyle}"
                Padding="20,18"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PC Remote Control Server"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <Border Background="{StaticResource BrushSurfaceRaised}"
                                BorderBrush="{StaticResource BrushBorderStrong}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,3"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCaptureEngine"
                                       Text="DirectX DXGI (GPU)"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccent}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Control your Windows desktop from Android over a secure local connection."
                               FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,5,12,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Border x:Name="StatusBadge"
                            Style="{StaticResource StatusBadgeStyle}"
                            Margin="0,0,12,0"
                            AutomationProperties.Name="Server status">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusIndicatorDot"
                                     Width="8"
                                     Height="8"
                                     Fill="{StaticResource BrushSuccess}"
                                     Margin="0,0,7,0" />
                            <TextBlock x:Name="TxtStatus"
                                       Text="STOPPED"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushSuccess}" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnToggleServer"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Start Server"
                            Width="132"
                            Click="BtnToggleServer_Click"
                            AutomationProperties.Name="Start or stop server"
                            AutomationProperties.HelpText="Starts or stops the WebSocket and LAN discovery services."
                            ToolTip="Start or stop the server"
                            TabIndex="3" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ConnectionPanel"
                    Grid.Column="0"
                    Style="{StaticResource PanelCardStyle}"
                    Margin="0,0,9,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="Connect from mobile"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Scan to pair"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushAccent}"
                                       Margin="12,2,0,0" />
                        </DockPanel>

                        <Border x:Name="BorderQrThumbnail"
                                Background="#FFFFFF"
                                BorderBrush="#D5DEE8"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonDown="BorderQrThumbnail_MouseLeftButtonDown"
                                ToolTip="Click to view enlarged QR code in center"
                                Margin="0,0,0,18">
                            <StackPanel HorizontalAlignment="Center">
                                <Image x:Name="ImgQrCode"
                                       Width="176"
                                       Height="176"
                                       Stretch="Uniform"
                                       AutomationProperties.Name="Server connection QR code"
                                       AutomationProperties.HelpText="Click to view enlarged QR code." />
                                <TextBlock Text="🔍 Click to enlarge"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#475569"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Server IP address" Style="{StaticResource FieldLabelStyle}" />
                        <Grid Margin="0,5,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtIpAddress"
                                     IsReadOnly="True"
                                     FontWeight="Bold"
                                     Foreground="{StaticResource BrushAccent}"
                                     AutomationProperties.Name="Server IP address"
                                     AutomationProperties.HelpText="The local IP address used by connected clients."
                                     TabIndex="1" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Button x:Name="BtnCopyIp"
                                        Content="Copy"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="BtnCopyIp_Click"
                                        AutomationProperties.Name="Copy server IP address"
                                        ToolTip="Copy the server IP address"
                                        TabIndex="2" />
                                <TextBlock x:Name="TxtCopyFeedback"
                                           Text=""
                                           FontSize="10"
                                           Foreground="{StaticResource BrushSuccess}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Connection port" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="TxtPort"
                                 Text="9090"
                                 Margin="0,5,0,0"
                                 LostFocus="TxtPort_LostFocus"
                                 TextChanged="TxtPort_TextChanged"
                                 AutomationProperties.Name="Connection port"
                                 AutomationProperties.HelpText="Enter a TCP port from 1 to 65535. Stop the server before changing it."
                                 ToolTip="TCP port used by the WebSocket server"
                                 TabIndex="0" />
                        <TextBlock x:Name="TxtPortValidation"
                                   Text=""
                                   Style="{StaticResource ValidationTextStyle}" />

                        <Border Background="{StaticResource BrushSurfaceRaised}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,14,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Active clients"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Text="Connected devices"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TxtClientCount"
                                           Grid.Column="1"
                                           Text="0 Devices"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushSuccess}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,18" />

                        <TextBlock Text="Stream configuration"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="Adjust these defaults for new and active sessions."
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Target FPS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="TxtFpsVal"
                                       Text="30 FPS"
                                       Style="{StaticResource ValueTextStyle}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="SliderFps"
                                Minimum="10"
                                Maximum="60"
                                Value="30"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                ValueChanged="SliderFps_ValueChanged"
                                AutomationProperties.Name="Target frames per second"
                                AutomationProperties.HelpText="Choose a target frame rate between 10 and 60 FPS."
                                ToolTip="Target frame rate: 10 to 60 FPS"
                                TabIndex="4" />

                        <DockPanel Margin="0,14,0,4">
                            <TextBlock Text="JPEG quality" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="TxtQualityVal"
                                       Text="70%"
                                       Style="{StaticResource ValueTextStyle}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="SliderQuality"
                                Minimum="20"
                                Maximum="95"
                                Value="70"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                ValueChanged="SliderQuality_ValueChanged"
                                AutomationProperties.Name="JPEG image quality"
                                AutomationProperties.HelpText="Choose JPEG quality between 20 and 95 percent."
                                ToolTip="JPEG quality: 20 to 95 percent"
                                TabIndex="5" />

                        <Separator Background="{StaticResource BrushBorder}" Margin="0,16,0,14" />

                        <TextBlock Text="System preferences"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,10" />

                        <Border Background="{StaticResource BrushSurfaceRaised}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Launch on Windows Startup"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Run server automatically on boot"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="ChkLaunchStartup"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          Click="ChkLaunchStartup_Click"
                                          AutomationProperties.Name="Launch on Windows Startup switch"
                                          ToolTip="Start server automatically when Windows boots up"
                                          TabIndex="6" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="ActivityPanel"
                    Grid.Column="1"
                    Style="{StaticResource PanelCardStyle}"
                    Margin="9,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Server activity" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Live events from the server and connected clients"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="BtnClearLogs"
                                Content="Clear logs"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="BtnClearLogs_Click"
                                AutomationProperties.Name="Clear server activity logs"
                                ToolTip="Clear the activity log"
                                TabIndex="6" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource BrushSurfaceInset}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <TextBox x:Name="TxtLogs"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="12"
                                 Background="Transparent"
                                 Foreground="{StaticResource BrushAccent}"
                                 BorderThickness="0"
                                 Padding="0"
                                 AutomationProperties.Name="Server activity log"
                                 AutomationProperties.HelpText="Live server activity messages." />
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource BrushSurfaceRaised}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Connection tip"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushWarning}" />
                            <TextBlock Text="Open the Android app, scan the QR code, or use Scan LAN. The connection starts without a PIN."
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterStatus"
                           Text="Server stopped"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0" />
                <TextBlock Grid.Column="1"
                           Text="Remote Desktop Windows Server v1.1"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="11"
                           TextAlignment="Right"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Modal Overlay for Enlarged Centered QR Code -->
        <Grid x:Name="QrModalOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#D909111F"
              MouseDown="QrModalOverlay_MouseDown">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseDown="QrModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Modal Header -->
                    <DockPanel Margin="0,0,0,16" Width="360">
                        <StackPanel>
                            <TextBlock Text="📱 Scan QR Code to Connect" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text="Point your Android camera at the QR code" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Content="✕"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                Padding="8,4"
                                FontSize="13"
                                FontWeight="Bold"
                                Click="BtnCloseQrModal_Click"/>
                    </DockPanel>

                    <!-- Enlarged QR Code -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#D5DEE8"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <Image x:Name="ImgQrCodeEnlarged"
                               Width="320"
                               Height="320"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Connection Info Badges -->
                    <Border Background="{StaticResource BrushSurfaceRaised}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Width="360"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Server Address" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock x:Name="TxtModalIpAddress" Text="192.168.0.103:9090" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                            </StackPanel>
                            <TextBlock Text="Instant Connect" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Content="Close (or press Esc)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="20,8"
                            Click="BtnCloseQrModal_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
